{
  "name": "tac-xpress",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "design:lint": "designmd lint docs/DESIGN.md",
    "design:diff": "designmd diff docs/DESIGN.md docs/DESIGN-v2.md",
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm to install dependencies.'); process.exit(1) }\"",
    "dev": "next dev --turbo",
    "dev:webpack": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:safe": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm stylelint && pnpm test:unit && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "audit:usage": "tsx scripts/audit-component-usage.ts",
    "generate:contracts": "tsx scripts/generate-api-contract.ts",
    "validate:contracts": "redocly lint contracts/cargo-api.json",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:seed": "tsx --env-file=.env.local scripts/seed-demo-data.ts",
    "db:sync": "tsx --env-file=.env.local scripts/sync-schema.ts",
    "db:types": "supabase gen types typescript --local > types/supabase.ts",
    "gbrain:init": "gbrain init --pglite",
    "gbrain:sync": "gbrain sync",
    "gbrain:serve": "gbrain serve",
    "gbrain:think": "gbrain think",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "node --env-file-if-exists=.env.local ./node_modules/chromatic/dist/bin.cjs --exit-zero-on-changes",
    "verify:production-env": "tsx --env-file-if-exists=.env.local scripts/verify-production-env.ts"
  },
