# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Auth
AUTH_SECRET=replace-with-a-long-random-secret
PORTAL_SESSION_SECRET=replace-with-a-long-random-secret

# Auth0 Next.js SDK
APP_BASE_URL=http://localhost:3000
AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-a-64-character-hex-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tac_xpress
SUPABASE_POOLER_URL=postgresql://postgres.projectid:password@aws-0-region.pooler.supabase.com:6543/postgres

# Security and edge protection
ARCJET_KEY=your-arcjet-key
CRON_SECRET=replace-with-a-long-random-secret
MOBILE_API_SECRET=replace-with-a-long-random-secret
PHONE_HASH_SECRET=replace-with-a-long-random-secret
INVOICE_PDF_SIGNING_SECRET=replace-with-a-long-random-secret

# AI
OPENROUTER_API=your-openrouter-api-key
OPENAI_MODEL=gpt-4o-mini
AI_AUTO_REPLY_ENABLED=false

# TypeSafe Jev: structured AI decisions (triage classification, priority, urgency)
# Optional: when absent, triage falls back to the OpenAI/OpenRouter path above.
# Get your key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Email
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=support@tac-xpress.app
OPS_NOTIFICATION_EMAIL=

# Mapping and analytics
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# WhatsApp outbound via LeminAI
WHATSAPP_ENABLED=false
WPBOX_API_TOKEN=
WPBOX_USER_ID=
WPBOX_BASE_URL=https://chat.leminai.com

# Separate Meta webhook validation
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Legacy direct Meta API inputs, unused by the current outbound relay
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Carrier integration
CARRIER_WEBHOOK_SECRET=replace-with-a-long-random-secret
RESEND_FROM_EMAIL=Tac-Xpress <updates@tac-xpress.app>

# E2E
E2E_TEST_BYPASS_ENABLED=false
NEXT_PUBLIC_E2E_TEST_BYPASS_ENABLED=false
E2E_TEST_SECRET=replace-with-a-long-random-secret
E2E_TEST_USER_PASSWORD=replace-with-a-strong-password
E2E_TEST_EMAIL=admin@test.tacexpress.app
PLAYWRIGHT_TEST=false
TEST_SPRITE_SESSION=

# Monitoring and optional diagnostics
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Development tracing opt-ins (both required to trace both server and browser in dev)
SENTRY_DEV_ENABLE=false
NEXT_PUBLIC_SENTRY_DEV_ENABLE=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
NEXT_PUBLIC_SYSTEM_BANNER=
ANALYZE=false

# Sentry source maps / release tracking (set in CI / Vercel env)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=

# Vercel Blob Storage
NEXT_PUBLIC_VERCEL_BLOB_HOSTNAME=your-project.public.blob.vercel-storage.com

# Offsite backup credentials stay local. Never use NEXT_PUBLIC_ names for these values.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tac-xpress-vault
S3_REGION=auto
# Store these operations settings in ignored .env.backup.local.
BACKUP_ROOT=
BACKUP_DATABASE_URL=
PG_BIN=
PG_DUMP_SHA256=
RESTIC_BIN=
RESTIC_SHA256=
BACKUP_PASSWORD_FILE=
BACKUP_REPOSITORY_ID=

# Chromatic visual testing (add to GitHub Actions secrets as CHROMATIC_PROJECT_TOKEN)
CHROMATIC_PROJECT_TOKEN=

#Testprite
# TestSprite API_KEY belongs in the Windows user environment.
